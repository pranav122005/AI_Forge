# AIForge Production Environment Configuration Example
# Copy to backend/.env or set these environment variables in your deployment system.

# Default Active LLM Provider: 'gemini', 'openai', or 'anthropic'
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security & CORS Settings
ALLOWED_ORIGINS=https://ai-forge-by-team-agni.onrender.com
SECURITY_AUTH_REQUIRED=false
AIFORGE_API_KEY=

# Agent & Execution Timeouts (seconds)
GENERATION_TIMEOUT=45
TEST_TIMEOUT=60
MAX_REPAIR_ATTEMPTS=3
