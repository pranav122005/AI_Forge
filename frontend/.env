# AIForge Frontend Environment Configuration
# Copy this file to frontend/.env or configure in your Vercel / hosting environment.

# API Base URL of the backend FastAPI service
# For local development: http://127.0.0.1:8000
# For production (Vercel): https://your-backend-vps-domain.com
VITE_API_BASE_URL=https://ai-forge-by-team-agni.onrender.com

# SECURITY NOTE:
# NEVER place Gemini, OpenAI, Anthropic, or any other secret API keys in frontend environment files.
# All VITE_* environment variables are compiled into the client-side JavaScript bundle and exposed to the public browser.
# All LLM provider keys and credentials MUST remain securely on the backend server.
