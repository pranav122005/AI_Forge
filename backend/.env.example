# AIForge Environment Variables Example
# Copy to .env and populate values as needed. NEVER commit real API keys to git.

# Default Active LLM Provider: 'gemini', 'openai', or 'anthropic'
DEFAULT_LLM_PROVIDER=gemini
LLM_PROVIDER=gemini

# Google Gemini Configuration (Primary / Default Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Security & CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURITY_AUTH_REQUIRED=false
AIFORGE_API_KEY=

# Timeouts & Execution Limits
GENERATION_TIMEOUT=45
TEST_TIMEOUT=60
MAX_REPAIR_ATTEMPTS=3
